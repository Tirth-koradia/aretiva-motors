# Local PostgreSQL used by Docker Compose
POSTGRES_DB=aretiva
POSTGRES_USER=aretiva
POSTGRES_PASSWORD=aretiva_dev
POSTGRES_PORT=55432

# Backend
DATABASE_URL=postgresql+psycopg://aretiva:aretiva_dev@localhost:55432/aretiva
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Seeded local demo administrator (never reuse these values in production)
ADMIN_EMAIL=admin@aretiva.com
ADMIN_PASSWORD=ChangeMe123!

# Frontend
VITE_API_URL=/api

